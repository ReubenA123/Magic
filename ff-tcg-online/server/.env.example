# Copy this file to ".env" (which is gitignored) and fill in real values.
# Never commit your actual .env file.

# The shared password you and your brother will type into the login screen.
# Pick something only the two of you know - it's the only thing standing
# between this game and anyone who finds the URL.
GAME_PASSWORD=Winton

# Port the game server listens on.
PORT=4000

# Where the client is served from, for CORS purposes. Update this if you
# deploy the client somewhere other than your local machine.
CLIENT_ORIGIN=http://localhost:5173
